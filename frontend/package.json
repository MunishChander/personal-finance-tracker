{
  "name": "@personal-finance-tracker/frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend React application for Personal Finance Tracker",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
